# Copy to .env.local and fill in from your Supabase project settings (API section).
# Only VITE_-prefixed vars are exposed to the client bundle.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push (Phase 7). Generate a VAPID key pair (e.g. `npx web-push generate-vapid-keys`).
# The PUBLIC key is safe in the client; the PRIVATE key is an Edge Function secret.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# --- Server-side only (never commit real values; used by supabase/seed.ts) ---
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SEED_OWNER_PHONE=+15555550100
# SEED_OWNER_EMAIL=owner@example.com

# --- Edge Function secrets (supabase secrets set …; used by send-notifications) ---
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:owner@example.com
